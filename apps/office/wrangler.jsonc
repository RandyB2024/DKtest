{
  "name": "destination-known-office-test",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "office.testadmin.nl", "custom_domain": true }],
  "triggers": {
    "crons": ["15 7 * * *"]
  },
  "assets": {
    "directory": "./worker-public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "OFFICE_ORIGIN": "https://office.testadmin.nl",
    "MFA_TRUST_MAX_AGE_SECONDS": "86400",
    "PASSKEYS_ENABLED": "false",
    "KVK_API_MODE": "test",
    "KVK_API_BASE_URL": "https://api.kvk.nl/test/api",
    "EMAILJS_SERVICE_ID": "service_crgn6gs",
    "EMAILJS_TEMPLATE_ID": "template_gmaawki",
    "EMAILJS_PUBLIC_KEY": "NQoJjpyBsuRCXnbyP",
    "PORTAL_BASE_URL": "https://mijn.testadmin.nl"
  }
}

