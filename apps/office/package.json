{
  "name": "destination-known-office-pwa",
  "version": "0.1.0",
  "private": true,
  "description": "Lokale PWA-MVP voor Destination Known Office",
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:worker": "node scripts/build-worker-assets.mjs",
    "dev:worker": "npm run build:worker && wrangler dev",
    "deploy:worker": "npm run build:worker && wrangler deploy"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "wrangler": "^4.141.0"
  }
}
