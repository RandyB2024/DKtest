SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
OFFICE_ORIGIN=http://127.0.0.1:4173
PORT=4173
ALLOW_DEVELOPMENT_AUTH=false
# Fixed security boundary; other values fail closed.
MFA_TRUST_MAX_AGE_SECONDS=86400
# Optional first-factor passkeys. Server-side only; default is disabled.
PASSKEYS_ENABLED=false
PASSKEY_RP_ID=testadmin.nl
# Set the exact HTTPS origin of THIS app before enabling (no trailing slash).
PASSKEY_ORIGIN=

# Non-secret KvK configuration; exact official base must match mode.
KVK_API_MODE=test
KVK_API_BASE_URL=https://api.kvk.nl/test/api
# Place real values ONLY in Cloudflare Worker secret bindings, never here.
KVK_API_KEY=
# Independent random 32-byte hex Worker capability; database stores its SHA-256.
KVK_INTAKE_RPC_KEY=
